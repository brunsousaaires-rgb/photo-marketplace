# URL de checkout da plataforma onde o produto é vendido (Cakto, Shopify, Kiwify, etc).
# Quando definida, todos os botões de compra do app e da página de oferta apontam para ela
# (com ?area=<ombro|coluna|joelho|quadril> anexado quando disponível).
# Se deixar em branco, os botões de compra apontam para a seção de preço da própria página (#preco).
VITE_CHECKOUT_URL=https://pay.cakto.com.br/seu-produto

# Número de WhatsApp (formato internacional, só dígitos, ex: 5511999999999)
# usado pela função getWhatsappUrl para links de recuperação/remarketing.
VITE_WHATSAPP_NUMBER=
